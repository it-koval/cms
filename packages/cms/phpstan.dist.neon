# Static analysis of the bundle and tests: composer stan. The types in docblocks are hints, not facts (treatPhpDocTypesAsCertain),
# because the data of the site comes out of JSON columns and the docblocks describe what the code expects to find there.
parameters:
    level: 6
    treatPhpDocTypesAsCertain: false
    # Test clients, repositories and caches can change between identical calls.
    rememberPossiblyImpureFunctionValues: false
    paths:
        - src
        - tests
    tmpDir: .phpstan.cache
    ignoreErrors:
        # symfony/asset is optional and AnalyticsAsset can be used without it.
        -
            message: '#Symfony\\Component\\Asset\\PackageInterface#'
            identifier: class.notFound
            path: src/Analytics/AnalyticsAsset.php
            reportUnmatched: false

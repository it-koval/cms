.idea
.DS_Store
vendor
node_modules
var
public/uploads
public/bundles
.env.local
.env.*.local
.env.local.php
config/secrets/*/*.decrypt.private.php
compose.override.yaml
.phpunit.cache
.phpstan.cache
.php-cs-fixer.cache
tests/App/var

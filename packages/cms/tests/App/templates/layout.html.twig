{#- Layout of the test site: the head carries the tags of itk_seo(), the pages declare block content. -#}
{%- set page = page|default({}) -%}
{%- set seo = itk_seo({title: 'Test site', robots: 'index,follow'}) -%}
{#- Probes of PageCacheTest: the address of the page says what the template asks of the cache of pages (a query string would bypass the cache): /test-pc-probe-<layout>-<block>, where each part is a number of seconds, `off` or `none` (no call), once in the layout, once in a block; /test-pc-boom breaks, /test-pc-session starts a session during the render. -#}
{%- set probe = (page.url|default('') starts with '/test-pc-probe-') ? page.url|slice(15)|split('-') : [] -%}
{%- if probe|length == 2 and probe[0] != 'none' %}{% do itk_cache(probe[0] == 'off' ? false : probe[0] + 0) %}{% endif -%}
{%- if page.url|default('') == '/test-pc-boom' %}{{ 1 / 0 }}{% endif -%}
{%- if page.url|default('') == '/test-pc-session' %}{% do app.session.start() %}{% endif -%}
<!DOCTYPE html>
<html lang="{{ page.locale|default('ru') }}">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    {{ itk_stylesheets() }}
    {#- A layout that prints its own Organization (SchemaOrgTest). -#}
    {%- if page.url|default('') == '/test-ld-own' %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"Своя организация"}</script>{% endif %}

    {% block meta %}
        {%- if probe|length == 2 and probe[1] != 'none' %}{% do itk_cache(probe[1] == 'off' ? false : probe[1] + 0) %}{% endif -%}
        <title>{{ seo.title }}</title>
        {% if seo.description != '' %}<meta name="description" content="{{ seo.description }}"/>{% endif %}
        <meta name="robots" content="{{ seo.robots }}"/>
        {%- if seo.canonical != '' %}
        <link rel="canonical" href="{{ seo.canonical }}"/>
        {%- endif %}{% for alternate in seo.alternates %}<link rel="alternate" hreflang="{{ alternate.hreflang }}" href="{{ alternate.href }}">{% endfor %}
        <meta property="og:type" content="website"/>
        <meta property="og:title" content="{{ seo.title }}"/>
        {% if seo.description != '' %}<meta property="og:description" content="{{ seo.description }}"/>{% endif %}
        {% if seo.ogImage != '' %}<meta property="og:image" content="{{ seo.ogImage }}"/>{% endif %}
        {% if seo.canonical != '' %}<meta property="og:url" content="{{ seo.canonical }}"/>{% endif %}
    {% endblock %}
</head>
<body>
    <main>
        {% block content %}{% endblock %}
    </main>
</body>
</html>

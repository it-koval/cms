# Not part of the Composer archive: a site needs none of this
/tests export-ignore
/scripts export-ignore
/phpunit.dist.xml export-ignore
/phpstan.dist.neon export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore

# The built admin is generated by `npm run build` in admin/: hide it from diffs
public/admin/** linguist-generated=true -diff

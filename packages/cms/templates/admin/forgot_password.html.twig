{# «Забыли пароль?» (/admin/forgot-password). Variables: available (can the site send mail), sent (the neutral answer), error, csrf_token, action, login_url. #}
{% extends '@ItkCms/admin/_auth.html.twig' %}
{% block title %}{{ itk_t('http.forgot_title') }}{% endblock %}
{% block content %}
    <h1>{{ itk_t('http.forgot_password') }}</h1>
{% if not available %}
    <p class="lead">{{ itk_t('http.forgot_unavailable') }}</p>
{% elseif sent %}
    <p class="ok" role="status">{{ itk_t('http.forgot_sent') }}</p>
    <p class="hint">{{ itk_t('http.forgot_sent_hint') }}</p>
{% else %}
    <p class="lead">{{ itk_t('http.forgot_lead') }}</p>
{% if error %}
    <p class="error" role="alert">{{ error }}</p>
{% endif %}
    <form method="post" action="{{ action }}">
        <label for="itk-email">{{ itk_t('http.email_label') }}</label>
        <input id="itk-email" type="email" name="email" autocomplete="username" autocapitalize="off" spellcheck="false" required autofocus>
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <button type="submit">{{ itk_t('http.forgot_send') }}</button>
    </form>
{% endif %}
    <a class="back" href="{{ login_url }}">{{ itk_t('http.back_to_login') }}</a>
{% endblock %}

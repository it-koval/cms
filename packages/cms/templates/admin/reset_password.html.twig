{# A new password by the link of a letter (/admin/reset-password/{token}). Variables: gone (the link does not work), invite (a new person), error, csrf_token, action, login_url, forgot_url. #}
{% extends '@ItkCms/admin/_auth.html.twig' %}
{% block title %}{{ itk_t(gone ? 'http.reset_gone_title' : (invite ? 'http.reset_invite_title' : 'http.new_password')) }}{% endblock %}
{% block content %}
{% if gone %}
    <h1>{{ itk_t('http.reset_gone_title') }}</h1>
    <p class="lead">{{ itk_t('http.reset_gone_lead') }}</p>
    <a class="back" href="{{ forgot_url }}">{{ itk_t('http.reset_request_new') }}</a>
{% else %}
    <h1>{{ itk_t(invite ? 'http.reset_invite_heading' : 'http.new_password') }}</h1>
    <p class="lead">{{ itk_t(invite ? 'http.reset_invite_lead' : 'http.reset_lead') }}</p>
{% if error %}
    <p class="error" role="alert">{{ error }}</p>
{% endif %}
    <form method="post" action="{{ action }}">
        <label for="itk-password">{{ itk_t('http.new_password') }}</label>
        <input id="itk-password" type="password" name="password" autocomplete="new-password" minlength="{{ min_length }}" required autofocus>
        <p class="hint">{{ itk_t('http.reset_min_length', {length: min_length}) }}</p>
        <label for="itk-repeat">{{ itk_t('http.reset_repeat') }}</label>
        <input id="itk-repeat" type="password" name="repeat" autocomplete="new-password" minlength="{{ min_length }}" required>
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <button type="submit">{{ itk_t('http.reset_save') }}</button>
    </form>
    <a class="back" href="{{ login_url }}">{{ itk_t('http.back_to_login') }}</a>
{% endif %}
{% endblock %}

{% extends ['email/layout.html.twig', '@ItkCms/email/layout.html.twig'] %}
{% block preheader %}{{ itk_t('http.mail_reset_preheader', {valid: valid}) }}{% endblock %}
{% block content %}
<h1 style="margin:0 0 12px;font-size:20px;line-height:1.25;">{{ itk_t('http.new_password') }}</h1>
<p style="margin:0 0 12px;">{{ name != '' ? itk_t('http.mail_greeting_name', {name: name}) : itk_t('http.mail_greeting') }} {{ itk_t('http.mail_reset_asked', {email: email}) }}</p>
<p style="margin:0 0 20px;">{{ itk_t('http.mail_button_hint', {valid: valid}) }}</p>
<p style="margin:0 0 20px;"><a href="{{ url }}" style="display:inline-block;padding:12px 20px;border-radius:8px;background:#0B5D80;color:#FFFFFF;font-weight:600;text-decoration:none;">{{ itk_t('http.mail_reset_button') }}</a></p>
<p style="margin:0 0 12px;color:#586873;font-size:14px;">{{ itk_t('http.mail_link_fallback') }}<br><a href="{{ url }}" style="color:#0B5D80;word-break:break-all;">{{ url }}</a></p>
<p style="margin:0;color:#586873;font-size:14px;">{{ itk_t('http.mail_reset_ignore') }}</p>
{% endblock %}

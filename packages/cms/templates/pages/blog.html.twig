{% extends ['layout.html.twig', '@ItkCms/layout.html.twig'] %}

{% block content %}
    {{ render_sections(page) }}
    <ul class="itk-article-list">
        {% for article in listing(page) %}
            <li><a href="{{ article.url }}">{{ article.title }}</a>{% if article.fields.date|default('') != '' %} <time>{{ article.fields.date }}</time>{% endif %}</li>
        {% endfor %}
    </ul>
{% endblock %}

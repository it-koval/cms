{% extends ['layout.html.twig', '@ItkCms/layout.html.twig'] %}

{% block content %}
    <article>
        <h1>{{ itk_field(page, 'title') }}</h1>
        {% if page.fields.date|default('') != '' %}<time>{{ page.fields.date }}</time>{% endif %}
        {% if page.fields.cover.src|default('') != '' %}<img src="{{ media_url(page.fields.cover) }}" alt="{{ page.fields.cover.alt|default('') }}"{{ itk_field_attrs(page, 'cover') }}>{% endif %}
        <div class="itk-article-body">{{ itk_field(page, 'body') }}</div>
    </article>
    {{ render_sections(page) }}
{% endblock %}
